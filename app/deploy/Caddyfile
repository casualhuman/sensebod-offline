# Sensebod on the Raspberry Pi: example Caddy site (alternative to nginx.conf).
#
#   caddy validate --config deploy/Caddyfile
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Same behaviour as nginx.conf: SPA fallback, pre-compressed assets, year-long
# cache for hashed files, no-cache shell, security headers and CSP, byte ranges
# for media (Caddy's file_server supports Range requests by itself).
# The CSP hash is checked against index.html by "npm run build".

{
	auto_https off
	admin off
}

:80 {
	root * /var/www/sensebod-offline/current

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-tQjf8gvb2ROOMapIxFvFAYBeUJ0v1HCbOcSmDNXGtDo='; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer, same-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
		-Server
	}

	# API: the backend on the same Pi
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
		}
	}

	# Animation packages: other people's HTML, kept in a box
	handle_path /media/tryit/* {
		root * /var/lib/sensebod-offline/media/tryit
		header Content-Security-Policy "sandbox allow-scripts; default-src 'self' 'unsafe-inline' data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'"
		header Cache-Control "no-cache"
		file_server
	}

	# Media: large local files, streamed with byte ranges
	handle_path /media/* {
		root * /var/lib/sensebod-offline/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Content-hashed build output and versioned illustrations: cache for a year
	@immutable path /assets/* /illustrations/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed gzip
		}
	}

	# Everything else: a real file if there is one, otherwise the app shell
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server {
			precompressed gzip
		}
	}
}
