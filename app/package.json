{
  "name": "sensebod-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:real": "REAL_API=http://127.0.0.1:8000 vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build && SENSEBOD_DEMO=1 node scripts/postbuild.mjs",
    "preview:demo": "VITE_DEMO=1 vite preview --outDir dist-demo",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && node scripts/check-css.mjs",
    "lint:css": "node scripts/check-css.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size-report.mjs",
    "gen:mock": "node scripts/gen-mock-data.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-legacy": "8.2.4",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "27.0.1",
    "terser": "5.51.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "3.2.7"
  }
}
