# Sensebod Offline, ONLINE TEST SERVER only (deploy/online). The Pi uses app/deploy/nginx.conf.
#
# This is app/deploy/nginx.conf with the changes an internet-facing test server needs:
#   - listens on __PORT__ inside the container; HTTPS is done in front (the host, or Caddy);
#   - every response says "do not index" (X-Robots-Tag, /robots.txt);
#   - optional password for the whole site (SENSEBOD_BASIC_AUTH_USER / _PASSWORD);
#   - the client address comes from the proxy in front (private addresses only are trusted);
#   - the staff session cookie gets the Secure flag, as the site is reached over HTTPS;
#   - the small sample clips the demo lessons point at are served from the image;
#   - the Host passed to the API keeps the port, so the site also works on a non-standard port.
# Rendered at container start by deploy/online/supervise.mjs. Locations, cache rules and
# security headers are otherwise the Pi's.

user www-data;
worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }

http {
  access_log /dev/stdout;
  client_body_temp_path /tmp/nginx-body;
  proxy_temp_path /tmp/nginx-proxy;
  fastcgi_temp_path /tmp/nginx-fastcgi;
  uwsgi_temp_path /tmp/nginx-uwsgi;
  scgi_temp_path /tmp/nginx-scgi;

  server {
    listen __PORT__ default_server;
    listen [::]:__PORT__ default_server;
    server_name _;

    root /srv/sensebod-offline/web;
    index index.html;
    charset utf-8;
    charset_types text/css application/javascript application/json image/svg+xml text/vtt;

    types {
      text/html                 html;
      text/css                  css;
      application/javascript    js;
      application/json          json;
      image/svg+xml             svg;
      image/png                 png;
      image/jpeg                jpg jpeg;
      image/webp                webp;
      font/woff2                woff2;
      text/vtt                  vtt;
      video/mp4                 mp4 m4v;
      audio/mp4                 m4a;
      audio/mpeg                mp3;
      application/pdf           pdf;
      text/plain                txt;
    }
    default_type application/octet-stream;

    # The proxy in front (Fly, Render, Railway, Caddy) is on a private address; trust only those.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

__AUTH__

    gzip_static on;
    gzip on;
    gzip_comp_level 4;
    gzip_min_length 512;
    gzip_vary on;
    gzip_types application/json text/vtt;

    server_tokens off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 30s;

    location = /robots.txt {
      auth_basic off;
      add_header X-Robots-Tag "noindex, nofollow" always;
      default_type text/plain;
      return 200 "User-agent: *\nDisallow: /\n";
    }

    # For the host's health check: answers without the site password.
    location = /healthz {
      auth_basic off;
      add_header Cache-Control "no-store" always;
      add_header X-Robots-Tag "noindex, nofollow" always;
      proxy_pass http://127.0.0.1:8000/api/v1/health;
      proxy_set_header Host localhost;
      error_page 502 503 504 = @api_down;
    }

    location /assets/ {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      try_files $uri =404;
    }

    location /illustrations/ {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      try_files $uri =404;
    }

    location ~ ^/(brand|pictures)/|^/favicon\.png$ {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "no-cache" always;
      try_files $uri =404;
    }

    location /api/ {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "no-store" always;
      proxy_pass http://127.0.0.1:8000;
      proxy_http_version 1.1;
      # $http_host keeps the port (e.g. localhost:8080): the backend compares it with the browser's Origin.
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Authorization "";
__COOKIE_FLAGS__
      proxy_connect_timeout 5s;
      proxy_read_timeout 120s;
      client_max_body_size 2g;
      proxy_request_buffering off;
      proxy_intercept_errors off;
      error_page 502 503 504 = @api_down;
    }
    location @api_down {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "no-store" always;
      default_type application/json;
      return 503 '{"error":{"code":"unavailable","message":"The bag is starting. Please try again in a moment."}}';
    }

    # Sample clips for the demo lessons (the seed points at /media/sample-*.{mp4,m4a,vtt}).
    location ~ ^/media/(sample-[a-z]+\.(mp4|m4a|vtt))$ {
      alias /srv/sensebod-offline/sample-media/$1;
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "public, max-age=86400" always;
      gzip off;
      gzip_static off;
    }
    location /media/tryit/sample/ {
      alias /srv/sensebod-offline/sample-media/tryit/sample/;
      add_header Content-Security-Policy "sandbox allow-scripts; default-src 'self' 'unsafe-inline' data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Robots-Tag "noindex, nofollow" always;
      add_header Cache-Control "no-cache" always;
      try_files $uri $uri/index.html =404;
    }

    location /media/ {
      alias /data/sensebod-offline/media/;
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "public, max-age=86400" always;
      gzip off;
      gzip_static off;
      limit_rate_after 2m;
      limit_rate 190k;
      try_files $uri =404;
    }

    location /media/tryit/ {
      alias /data/sensebod-offline/media/tryit/;
      add_header Content-Security-Policy "sandbox allow-scripts; default-src 'self' 'unsafe-inline' data: blob:; connect-src 'none'; form-action 'none'; base-uri 'none'" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header X-Robots-Tag "noindex, nofollow" always;
      add_header Cache-Control "no-cache" always;
      try_files $uri $uri/index.html =404;
    }

    location = /index.html {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "no-cache" always;
    }

    location / {
      include /etc/nginx/sensebod-offline-online-headers.conf;
      add_header Cache-Control "no-cache" always;
      try_files $uri /index.html;
    }
  }
}
