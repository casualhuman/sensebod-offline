# Copy to deploy/online/online.env (git-ignored) and fill in. Never commit real passwords.
# On Fly.io / Render / Railway set the same names as secrets / environment variables instead.

# The address people will open, without https:// (several: comma-separated).
SENSEBOD_PUBLIC_HOST=localhost

# Staff (hub manager) account, created on first start if it does not exist. 10+ characters.
SENSEBOD_ADMIN_USERNAME=admin
SENSEBOD_ADMIN_PASSWORD=

# Optional: one password in front of the whole site (leave empty for an open demo).
SENSEBOD_BASIC_AUTH_USER=
SENSEBOD_BASIC_AUTH_PASSWORD=

# 1 (default): the staff cookie is sent over HTTPS only. Set 0 only to test over plain http://
# on a machine other than localhost.
SENSEBOD_COOKIE_SECURE=1

# Optional: an age public key (age1...) so the encrypted backup export can be tested.
SENSEBOD_BACKUP_RECIPIENTS=
